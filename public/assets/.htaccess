# Arquivos estáticos (CSS, JS, imagens). Nada de PHP executando por aqui, nem listagem da pasta.
Options -Indexes
<FilesMatch "\.(php|phtml|phar|php[0-9])$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
